{
  "name": "web3-agentic-organization",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-chain autonomous Web3 organization built on agent-global",
  "packageManager": "pnpm@10.26.1",
  "engines": { "node": ">=20.0.0", "pnpm": ">=10.0.0" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}