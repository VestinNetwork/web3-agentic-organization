# Copy to .env locally. Never commit credentials.
NODE_ENV=development
LOG_LEVEL=info

# Internal service URLs (private network only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web3_agentic_org
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
QDRANT_URL=http://localhost:6333

# Integration adapters are disabled unless explicit URLs and auth are configured.
AGENT_GLOBAL_BASE_URL=
AGENT_GLOBAL_INTEGRATION_ENABLED=false
OPENXERA_BASE_URL=
OPENXERA_INTEGRATION_ENABLED=false
ZIVI_CORE_BASE_URL=
ZIVI_CORE_INTEGRATION_ENABLED=false

# Blockchain read-only endpoints only. Never put private keys here.
EVM_RPC_URL=
SOLANA_RPC_URL=
